# Copy to .env.local for development. Never commit real values.
# In Vercel: Project → Settings → Environment Variables (Production + Preview).

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase pooled connection string (transaction pooler, port 6543) for Drizzle
DATABASE_URL=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL_DEEP=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# Geocoding (v1: OpenStreetMap Nominatim behind lib/geo interface)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires an identifying User-Agent with contact info,
# e.g. "Jyotish/1.0 (contact@example.com)"
NOMINATIM_USER_AGENT=
